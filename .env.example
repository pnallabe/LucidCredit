OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# === Azure OpenAI (Primary — required in staging/prod) ===
# Replace direct OpenAI API with Azure OpenAI for data residency compliance (BAA/DPA)
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Lock to a specific GA API version — update only after regression testing
AZURE_OPENAI_API_VERSION=2024-10-21
# Dated deployment names ensure reproducible model behaviour — never use "latest"
AZURE_OPENAI_DEPLOYMENT_ANALYST=gpt-4.1-2025-04-14
AZURE_OPENAI_DEPLOYMENT_APPLICANT=gpt-4.1-2025-04-14
# Must match the pgvector column dimension (3072) — re-ingest corpus if changed
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large

# === Provider Mode ===
# "azure" = use Azure OpenAI (required in staging/production)
# "openai_direct" = use direct OpenAI API (development only)
LLM_PROVIDER_MODE=azure

# === Vertex AI / Gemini (Fallback for analyst sessions) ===
# Application Default Credentials (ADC) are preferred over an API key in production.
# For local dev with a service account: set GOOGLE_APPLICATION_CREDENTIALS to the JSON key path.
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us-central1
# Vertex fallback model for analyst/briefing sessions when Azure is unavailable
VERTEX_MODEL_ANALYST_FALLBACK=gemini-1.5-pro-002
# Gemini 2.0 Flash for cost-optimised batch briefings (enabled via RAGAS gate only)
VERTEX_MODEL_BATCH_BRIEFING=gemini-2.0-flash-001
# Set to false to disable Vertex fallback for analyst sessions
ANALYST_FALLBACK_ENABLED=true
# A/B gate — do NOT set to true manually; use POST /v1/briefing/evaluate-flash
BRIEFING_USE_FLASH=false

DATABASE_URL=postgresql+asyncpg://lucidcredit:password@localhost:5432/lucidcredit
VECTOR_DB_URL=postgresql+asyncpg://lucidcredit:password@localhost:5432/lucidcredit
REDIS_URL=redis://localhost:6379
CRP_API_BASE_URL=http://localhost:8081
CRP_API_KEY=
THINFILE_API_BASE_URL=http://localhost:8000
THINFILE_API_KEY=
API_KEY_SALT=
JWT_SECRET=
# Admin API key required for POST /v1/briefing/evaluate-flash (analyst admin only)
ADMIN_API_KEY=
MIN_CITATION_SIMILARITY=0.85
MIN_CONFIDENCE_SCORE=0.75
ENVIRONMENT=development
LOG_LEVEL=INFO

